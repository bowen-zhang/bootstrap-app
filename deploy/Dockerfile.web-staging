FROM nginx:stable-alpine

WORKDIR /usr/local/app

COPY ./runtime/nginx/localhost+2-key.pem /etc/nginx/
COPY ./runtime/nginx/localhost+2.pem /etc/nginx/
COPY ./nginx/nginx-staging.conf.template /etc/nginx/templates/default.conf.template
COPY ./runtime/web /var/www/html

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]